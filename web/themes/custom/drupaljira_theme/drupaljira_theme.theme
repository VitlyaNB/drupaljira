<?php

/**
 * @file
 * Functions to support theming in the DrupalJira theme.
 */

/**
 * Implements hook_preprocess_views_view().
 */
function drupaljira_theme_preprocess_views_view(&$variables) {
  $view = $variables['view'];

  if ($view->id() === 'task_board') {
    $columns = [
      'backlog' => [],
      'in_progress' => [],
      'review' => [],
      'done' => [],
    ];

    if (!empty($view->result)) {
      foreach ($view->result as $index => $row) {
        $node = $row->_entity ?? NULL;

        if (!$node) {
          continue;
        }

        $raw_status = strtolower($node->get('field_status')->value ?? '');

        $status_key = 'backlog';
        if (str_contains($raw_status, 'progress')) {
          $status_key = 'in_progress';
        }
        elseif (str_contains($raw_status, 'review')) {
          $status_key = 'review';
        }
        elseif (str_contains($raw_status, 'done')) {
          $status_key = 'done';
        }

        $rendered_row = NULL;
        if (isset($variables['rows'][0]['#rows'][$index])) {
          $rendered_row = $variables['rows'][0]['#rows'][$index];
        }
        elseif (isset($variables['rows'][$index])) {
          $rendered_row = $variables['rows'][$index];
        }

        if ($rendered_row) {
          $columns[$status_key][] = [
            '#nid' => $node->id(),
            '#content' => $rendered_row,
          ];
        }
      }
    }

    $variables['kanban_columns'] = $columns;
  }
}
