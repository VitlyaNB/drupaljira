<article{{ attributes.addClass('task-teaser') }}>
  <h4 class="task-title" style="margin: 0 0 8px 0;">
    <a href="{{ path('entity.node.canonical', {'node': node.id()}) }}"
       class="use-ajax"
       data-dialog-type="modal"
       data-dialog-options='{"width": 800, "dialogClass": "task-modal"}'>
      {{ label }}
    </a>
  </h4>

  {% if content.field_priority %}
    <div class="task-priority">{{ content.field_priority }}</div>
  {% endif %}
</article>
