<?php

/**
 * @file
 * Primary module hooks for DrupalJira TimeLog module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function drupaljira_timelog_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();

  // 1. Ensure entity exists and bundle is strictly 'task'.
  if (!$entity instanceof EntityInterface || $entity->bundle() !== 'task') {
    return;
  }

  // 2. Ensure the entity is saved and has an ID (skip on /node/add/task).
  if ($entity->isNew() || !$entity->id()) {
    return;
  }

  // 3. Build route URL using Drupal standard Url generator.
  $url = Url::fromRoute('drupaljira_timelog.task_log_time', [
    'task' => $entity->id(),
  ]);

  // 4. Add "Log time" link element to the form actions block.
  $form['actions']['log_time'] = [
    '#type' => 'link',
    '#title' => t('Log time'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button', 'button--secondary'],
    ],
    '#weight' => 15,
  ];
}
