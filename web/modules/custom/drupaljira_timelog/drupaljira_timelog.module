<?php

/**
 * @file
 * Primary module hooks for DrupalJira TimeLog module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function drupaljira_timelog_theme(): array {
  return [
    'drupaljira_project_stats' => [
      'variables' => [
        'project' => NULL,
        'stats' => [],
      ],
      'template' => 'drupaljira-project-stats',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for drupaljira_project_stats.
 */
function template_preprocess_drupaljira_project_stats(array &$variables): void {
  /** @var \Drupal\Core\Entity\EntityInterface|null $project */
  $project = $variables['project'] ?? NULL;

  if (!$project instanceof EntityInterface) {
    return;
  }

  /** @var \Drupal\drupaljira_timelog\Service\TaskStatService $task_stat_service */
  $task_stat_service = \Drupal::service('drupaljira.task_stat');
  /** @var \Drupal\drupaljira_timelog\Service\DurationFormatter $duration_formatter */
  $duration_formatter = \Drupal::service('drupaljira.duration_formatter');

  $raw_stats = $task_stat_service->getProjectStats($project);

  $total_estimate = (float) $raw_stats['total_estimate'];
  $total_logged = (float) $raw_stats['total_logged'];
  $remaining = $total_estimate - $total_logged;

  $variables['project_title'] = $project->label();
  $variables['total_tasks'] = (int) $raw_stats['total_tasks'];
  $variables['done_tasks'] = (int) $raw_stats['done_tasks'];
  $variables['total_estimate_formatted'] = $duration_formatter->format($total_estimate);
  $variables['total_logged_formatted'] = $duration_formatter->format($total_logged);
  $variables['overestimate_tasks'] = (int) $raw_stats['overestimate_tasks'];

  if ($remaining < 0) {
    $variables['remaining_hours_formatted'] = (string) t('OVERDUE by @overdue', [
      '@overdue' => $duration_formatter->format(abs($remaining)),
    ]);
    $variables['is_overdue'] = TRUE;
  }
  else {
    $variables['remaining_hours_formatted'] = (string) t('@remaining remaining', [
      '@remaining' => $duration_formatter->format($remaining),
    ]);
    $variables['is_overdue'] = FALSE;
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function drupaljira_timelog_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  $entity = $form_object->getEntity();

  if (!$entity instanceof EntityInterface || $entity->bundle() !== 'task') {
    return;
  }

  if ($entity->isNew() || !$entity->id()) {
    return;
  }

  $url = Url::fromRoute('drupaljira_timelog.task_log_time', [
    'task' => $entity->id(),
  ]);

  $form['actions']['log_time'] = [
    '#type' => 'link',
    '#title' => t('Log time'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button', 'button--secondary'],
    ],
    '#weight' => 15,
  ];
}

/**
 * Helper to invalidate project stats cache tag from time_log entity.
 *
 * @param \Drupal\Core\Entity\EntityInterface $time_log
 *   The TimeLog entity.
 */
function _drupaljira_timelog_invalidate_project_stats_cache(EntityInterface $time_log): void {
  if (!$time_log->hasField('task') || $time_log->get('task')->isEmpty()) {
    return;
  }

  /** @var \Drupal\Core\Entity\EntityInterface|null $task */
  $task = $time_log->get('task')->entity;
  if (!$task instanceof EntityInterface || !$task->hasField('field_project') || $task->get('field_project')->isEmpty()) {
    return;
  }

  $project_id = $task->get('field_project')->target_id;
  if ($project_id) {
    Cache::invalidateTags(['drupaljira_project_stats:' . $project_id]);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for time_log.
 */
function drupaljira_timelog_time_log_insert(EntityInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for time_log.
 */
function drupaljira_timelog_time_log_update(EntityInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for time_log.
 */
function drupaljira_timelog_time_log_delete(EntityInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);
}
